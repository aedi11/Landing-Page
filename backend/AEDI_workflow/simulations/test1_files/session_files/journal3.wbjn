    Variables=["Thermal Conductivity Y direction"],
    Values=[["1 [W m^-1 C^-1]"]])
matlProp8.SetData(
    Variables=["Thermal Conductivity Z direction"],
    Values=[["25 [W m^-1 C^-1]"]])
Save(Overwrite=True)
modelComponent1.Refresh()
model1.Edit()
Save(Overwrite=True)
model1.Exit()
