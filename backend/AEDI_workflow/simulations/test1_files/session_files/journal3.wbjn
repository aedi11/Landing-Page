    Name="Specific Heat",
    Definition="Constant Pressure",
    Qualifiers={"Definition": "Constant Pressure", "Behavior": ""})
matlProp3.SetData(
    Index=-1,
    Variables=["Specific Heat"],
    Values=[["385 [J kg^-1 C^-1]"]])
matlProp4 = matl1.CreateProperty(
    Name="Resistivity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp4.SetData(
    Index=-1,
    Variables=["Resistivity"],
    Values=[["1.68E-08 [ohm m]"]])
matlProp5 = matl2.CreateProperty(
    Name="Thermal Conductivity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp6 = matl2.CreateProperty(
    Name="Density",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp6.SetData(
    Index=-1,
    Variables=["Density"],
    Values=[["2730 [kg m^-3]"]])
matlProp5.SetData(
    Index=-1,
    Variables=["Thermal Conductivity"],
    Values=[["190 [W m^-1 C^-1]"]])
matlProp7 = matl2.CreateProperty(
    Name="Specific Heat",
    Definition="Constant Pressure",
    Qualifiers={"Definition": "Constant Pressure", "Behavior": ""})
matlProp7.SetData(
    Index=-1,
    Variables=["Specific Heat"],
    Values=[["893 [J kg^-1 C^-1]"]])
matlProp6.SetData(
    Variables=["Density"],
    Values=[["2200 [kg m^-3]"]])
matlProp7.SetData(
    Variables=["Specific Heat"],
    Values=[["1000 [J kg^-1 C^-1]"]])
matlProp5.Delete(Behavior="Isotropic")
matlProp8 = matl2.CreateProperty(
    Name="Thermal Conductivity",
    Behavior="Orthotropic",
    Qualifiers={"Definition": "", "Behavior": "Orthotropic"})
matlProp8.SetData(
    Index=-1,
    Variables=["Thermal Conductivity X direction"],
    Values=[["25 [W m^-1 C^-1]"]])
